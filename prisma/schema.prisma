// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 Int                      @id @default(autoincrement())
  email              String                   @unique
  password           String
  name               String?
  role               String                   @default("user") // "user" or "admin"
  createdAt          DateTime                 @default(now())
  emailVerifiedAt    DateTime?
  wallet             Wallet?
  transactions       Transaction[]
  cryptoAssets       CryptoAsset[]
  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  passwordResetToken PasswordResetToken?
}

model PasswordResetToken {
  userId    Int      @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AuthThrottle {
  key          String    @id
  attempts     Int       @default(0)
  resetAt      DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([resetAt])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  event       String
  category    String
  summary     String
  userId      Int?
  actorUserId Int?
  ipHash      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
}

model Wallet {
  id          Int   @id @default(autoincrement())
  fiatBalance Float @default(0.0)
  user        User  @relation(fields: [userId], references: [id])
  userId      Int   @unique
}

model Transaction {
  id           Int      @id @default(autoincrement())
  type         String // e.g., "buy", "sell", "deposit", "withdrawal"
  cryptoSymbol String? // The crypto involved (if applicable)
  coinId       String?
  amount       Float // Amount of crypto (if applicable)
  price        Float // Price per unit in fiat at the time of transaction
  fiatAmount   Float // Total fiat value of the transaction
  fiatCurrency String   @default("USD") // Added default value
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  userId       Int
}

model CryptoAsset {
  id      Int    @id @default(autoincrement())
  symbol  String // e.g., "BTC", "ETH", etc.
  coinId  String // e.g., "bitcoin", "ethereum", etc.
  balance Float  @default(0)
  user    User   @relation(fields: [userId], references: [id])
  userId  Int
}
